# /etc/update-airlock/.env  -  secrets for update-airlock. Permissions: root:root 600.
# After a change nothing needs a restart: every run reads this file again.

# Home Assistant long-lived access token (HA: profile -> Security -> Long-lived access tokens).
# Rotate: create a new token, paste it here, delete the old one in HA.
HA_TOKEN=

# Optional: GitHub token (no scopes needed) for a higher API limit when reading HA release notes.
GITHUB_TOKEN=

# Optional: credentials for private registries, referenced in config.yaml (check.registry_credentials)
# GHCR_CREDENTIALS=user:token
