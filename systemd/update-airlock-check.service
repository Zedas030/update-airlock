[Unit]
Description=update-airlock: look for new images, read release notes, test candidates in the sandbox
Documentation=file:///opt/update-airlock/app/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=update-airlock-failure@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/update-airlock check
# Remove sandbox leftovers if the run was killed or failed (normal runs clean up themselves)
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" = success ] || /usr/local/bin/update-airlock cleanup'
TimeoutStartSec=3h
KillSignal=SIGTERM
TimeoutStopSec=5min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=512M
CPUQuota=50%
# Hardening (the tool needs root: Docker, iptables, root-owned data dirs)
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
